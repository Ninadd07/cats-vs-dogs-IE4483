# Local data, environments and caches
/datasets/
__pycache__/
*.py[cod]
.DS_Store
.vscode/
.venv/
venv/
.conda/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/

# Checkpoints, batch logs and temporary files
*.pth
*.pt
*.ckpt
*.log
slurm-*.out
slurm-*.err
*.tmp
*.temp
*.bak

# Keep only report artifacts eligible for Git; retain other outputs locally.
/datapreprocessing/outputs/*
!/datapreprocessing/outputs/augmentation_examples.png
!/datapreprocessing/outputs/dataset_summary.json
!/datapreprocessing/outputs/dataset_summary.txt
!/datapreprocessing/outputs/visualization_settings.json

/custom_cnn/outputs/*
!/custom_cnn/outputs/run_a/
/custom_cnn/outputs/run_a/*
!/custom_cnn/outputs/run_a/config.json
!/custom_cnn/outputs/run_a/training_history.csv
!/custom_cnn/outputs/run_a/accuracy_curve.png
!/custom_cnn/outputs/run_a/loss_curve.png

/custom_cnn/predictions_and_evaluation/outputs/*
!/custom_cnn/predictions_and_evaluation/outputs/submission.csv
!/custom_cnn/predictions_and_evaluation/outputs/validation_metrics.json
!/custom_cnn/predictions_and_evaluation/outputs/classification_report.csv
!/custom_cnn/predictions_and_evaluation/outputs/confusion_matrix.png
!/custom_cnn/predictions_and_evaluation/outputs/validation_examples.png
!/custom_cnn/predictions_and_evaluation/outputs/prediction_examples.png

# CIFAR-10 runs: keep configs, histories and metrics; drop checkpoints and feature caches.
/cifar10/outputs/**
!/cifar10/outputs/**/
!/cifar10/outputs/**/config.json
!/cifar10/outputs/**/training_history.csv
!/cifar10/outputs/**/test_metrics.json
!/cifar10/outputs/**/teacher_results.json

# Custom-CNN sweep and augmentation runs: keep configs, histories and metrics only.
!/custom_cnn/outputs/sweep/
!/custom_cnn/outputs/augmentation/
/custom_cnn/outputs/sweep/**
/custom_cnn/outputs/augmentation/**
!/custom_cnn/outputs/sweep/**/
!/custom_cnn/outputs/augmentation/**/
!/custom_cnn/outputs/sweep/sweep_results.csv
!/custom_cnn/outputs/sweep/**/config.json
!/custom_cnn/outputs/sweep/**/training_history.csv
!/custom_cnn/outputs/sweep/**/validation_metrics.json
!/custom_cnn/outputs/augmentation/**/config.json
!/custom_cnn/outputs/augmentation/**/training_history.csv
!/custom_cnn/outputs/augmentation/**/validation_metrics.json

# Pretrained ResNet-50 / ViT-B/16 runs (root train.py): keep training logs only.
/outputs/**
!/outputs/**/
!/outputs/pretrained/*_seed*/train.log

# Slurm job logs
/logs/
